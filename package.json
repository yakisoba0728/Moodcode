{
  "name": "moodcode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/engine",
    "apps/engine-harness",
    "apps/desktop"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build && node scripts/test.mjs",
    "test:engine": "node scripts/test-engine.mjs",
    "eval:engine": "npm run build && node scripts/evaluate-engine.mjs",
    "harness": "node apps/engine-harness/dist/index.js",
    "check": "npm run typecheck && npm test",
    "test:electron": "npm run build && electron scripts/electron-smoke.cjs",
    "test:electron-runtime": "npm run build && node scripts/electron-runtime-check.cjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "doctor": "npm run build && node scripts/doctor.mjs",
    "build:desktop": "npm run build && tsc -p apps/desktop/tsconfig.renderer.json --noEmit && node scripts/build-desktop.mjs",
    "desktop": "npm run build:desktop && electron apps/desktop",
    "test:desktop": "npm run build:desktop && node scripts/test-desktop.mjs && node scripts/test-desktop-settings.mjs",
    "package:desktop": "npm run build:desktop && electron-builder --config apps/desktop/electron-builder.config.cjs --mac --arm64 --dir",
    "test:desktop-package": "npm run package:desktop && node scripts/test-desktop-package.mjs",
    "verify:codex": "npm run build && node scripts/verify-codex.mjs --live"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
