  "units": [
    {
      "id": "CORE-01",
      "implementation": "One private typed fresh media input validator is called inside the two original fresh-receipt branches. Original lookup short circuit, profile application, native scheduler calls and resolver closing checks remain.",
      "contracts": [
        "budget -> segment -> document -> image",
        "durable duplicates bypass deleted sources",
        "no native Input/Run/Message/Attempt/event or HTTP effect before validation succeeds",
        "unknown token cost and byte accounting unchanged"
      ],
      "regressions": [
        "actual mixed source deletion/restoration independently pins segment/document/image error priority through v1 and v2",
        "oversized combined reference metadata rejects before any segment support check or native effect",
        "image existing duplicate plus new PDF/audio duplicate cases cover both APIs after deletion, exact receipt identity, conflict rejection and no repeat attempt"
      ],
      "qualification": "Public normalizers independently enforce the same combined budget before this helper; the public budget regression verifies externally observable priority and does not isolate a later redundant assertion."
    },
    {
      "id": "CORE-02",
      "implementation": "One private non-async factory tracker invokes the concrete import synchronously, registers its original Promise and removes it on either settlement. Three wrappers return that original Promise.",
      "contracts": [
        "immediate ENGINE_CLOSED rejected Promise before factory invocation",
        "caller then host AbortSignal.any order; absent caller uses exact host signal",
        "synchronous factory throw remains synchronous",
        "native CAS/index stores and close joining unchanged"
      ],
      "regressions": [
        "controlled factories pin original Promise identity, synchronous entry/throw, pending addition/deletion on fulfilment and rejection, already-aborted caller/host precedence, closed no-factory behavior",
        "actual image/PDF/audio close before CAS cancels without durable index; post-CAS close retains exact blob/ref after native reopen with no provider or Input/Run effects"
      ]
    },
    {
      "id": "CORE-03",
      "implementation": "Twenty-eight guard calls remain at their original constructor positions. The private helper reads options[key] once for undefined and twice for a non-undefined value under the original short circuit; it does not cache the value.",
      "contracts": [
        "all original INVALID_CONFIG codes/messages",
        "initial osSandbox assignment before dbPath validation",
        "PR feedback loop is unchanged and excluded from the28 guards",
        "interleaved dependencies, error priority and child opt-ins unchanged"
      ],
      "regressions": [
        "28 independently authored exact invalid messages and getter counts (2 each; osSandbox3 including its earlier assignment)",
        "undefined short circuit and six later-invalid/earlier-dependency error cases",
        "actual native team model/default-off child, scoped child owner, resident close/restart/archive, coding batch archive/no replay, command lifetime and role child suites"
      ]
    }
  ],
