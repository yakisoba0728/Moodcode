  "primarySources": [
    {
      "url": "https://raw.githubusercontent.com/nodejs/node/v24.20.0/src/node_sqlite.cc",
      "lines": "497–547,578–599",
      "finding": "BackupJob accepts BUSY/LOCKED from the worker step, then checks remaining pages. With zero remaining and status other than DONE it constructs the rejection from the destination connection rather than the step status. An initially locked step can therefore report destination error code zero. This explains the reproduced symptom, not the unobserved CI operation."
    },
    {
      "url": "https://www.sqlite.org/c3ref/backup_finish.html",
      "finding": "The official API documents immediate LOCKED when the source connection is being used to write. Backup page counts are updated by backup_step. A different read handle with an established WAL snapshot avoids sharing that active writer transaction."
    },
    {
      "url": "https://raw.githubusercontent.com/nodejs/node/v26.9.0/src/node_sqlite.cc",
      "lines": "589–650",
      "finding": "The same remaining-pages/status decision is present in this Node26 source; no Node24-only or macOS-only cause is established."
